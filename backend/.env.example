PORT=5000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rommie
JWT_SECRET=super-secret-jwt-key-for-development-only-change-in-prod-min-32-chars
COOKIE_SECRET=super-secret-cookie-key-for-signing-cookies-min-32-chars
CORS_ORIGIN=http://localhost:5173,https://smudgy-sitter-snugness.ngrok-free.dev
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
EMAIL_FROM=alerts@rommie.co.ke
EMAIL_FROM_NAME=Rommie
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Cloudflare S3-compatible R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=rommie-media
R2_PUBLIC_URL=https://pub-rommie-media.r2.dev
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
