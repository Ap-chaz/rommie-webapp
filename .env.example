# Frontend Environment Configuration
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_R2_PUBLIC_URL=https://pub-rommie-media.r2.dev

# Cloudflare S3-compatible R2 Storage (Backend)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=rommie
R2_PUBLIC_URL=https://pub-rommie-media.r2.dev
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
